function median_(values){const rows=values.map(Number).filter(isFinite).sort(function(a,b){return a-b;});if(!rows.length)return NaN;const m=Math.floor(rows.length/2);return rows.length%2?rows[m]:(rows[m-1]+rows[m])/2;}
function numberFrom_(value){if(typeof value==='number')return value;const n=Number(String(value||'').replace(/[^0-9.]/g,''));return isFinite(n)?n:NaN;}
function parseQuantity_(title){const text=String(title||'').toLowerCase();const patterns=[[/([0-9]+(?:\.[0-9]+)?)\s*(lb|lbs|pound|pounds)\b/,'lb'],[/([0-9]+(?:\.[0-9]+)?)\s*(oz|ounce|ounces)\b/,'oz'],[/([0-9]+(?:\.[0-9]+)?)\s*(gallon|gallons|gal)\b/,'gallon'],[/([0-9]+(?:\.[0-9]+)?)\s*(gram|grams|g)\b/,'gram'],[/([0-9]+(?:\.[0-9]+)?)\s*(count|ct)\b/,'count'],[/([0-9]+(?:\.[0-9]+)?)\s*(kwh)\b/,'kwh']];for(let i=0;i<patterns.length;i++){const match=text.match(patterns[i][0]);if(match)return{quantity:Number(match[1]),unit:patterns[i][1]};}if(/dozen/.test(text))return{quantity:12,unit:'count'};return{quantity:NaN,unit:''};}
function normalizeUnit_(unit){const x=String(unit||'').toLowerCase();if(/^(lb|lbs|pound)/.test(x))return'lb';if(/^(oz|ounce)/.test(x))return'oz';if(/^(gram|g)$/.test(x))return'gram';if(/^(gallon|gal)/.test(x))return'gallon';if(/^(count|ct)/.test(x))return'count';if(/kwh/.test(x))return'kwh';return x;}
