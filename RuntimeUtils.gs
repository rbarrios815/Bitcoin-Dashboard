function ensureSheet_(ss,name,header){let sheet=ss.getSheetByName(name);if(!sheet)sheet=ss.insertSheet(name);if(sheet.getLastRow()===0){sheet.getRange(1,1,1,header.length).setValues([header]);sheet.setFrozenRows(1);return sheet;}const current=sheet.getRange(1,1,1,Math.max(sheet.getLastColumn(),header.length)).getValues()[0].map(String);header.forEach(function(label,index){if(current.indexOf(label)>=0)return;sheet.insertColumnBefore(index+1);sheet.getRange(1,index+1).setValue(label);current.splice(index,0,label);});sheet.setFrozenRows(1);return sheet;}
function indexHeader_(header){const out={};header.forEach(function(label,index){out[String(label||'').trim()]=index;});return out;}
function value_(row,index){return index===undefined||index===null?null:row[index];}
function parseDate_(value){if(!value)return null;const d=value instanceof Date?value:new Date(value);return isNaN(d.getTime())?null:d;}
